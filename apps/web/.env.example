# ============================================================
# Kalé web (PWA) — variables d'environnement de build
# Copier vers .env si besoin. Toutes optionnelles.
# ============================================================

# URL de base de l'API Kalé.
# - Dev  : http://localhost:4000 (défaut)
# - Prod : injectée par GitHub Actions depuis la variable du repo
#          `API_BASE` (voir .github/workflows/pages.yml).
VITE_API_BASE=http://localhost:4000

# Chemin de base du site sur GitHub Pages : /kale/ (défaut en build).
# Mettre "/" si vous déployez sur un domaine dédié.
# VITE_BASE_PATH=/kale/
