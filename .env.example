# ============================================================
# Kalé — variables d'environnement (copier vers .env)
#   cp .env.example .env
# Toutes les valeurs ci-dessous sont des défauts de DEV.
# ============================================================

# --- Phoenix / app ---
SECRET_KEY_BASE=
PORT=4000
PHX_HOST=localhost

# --- PostgreSQL ---
# En dev : postgres via docker-compose (voir docker-compose.yml)
DATABASE_URL=postgres://kale:kale_dev@localhost:5432/kale_dev

# --- Redis (en dev : localhost:6379 via docker-compose) ---
REDIS_URL=redis://localhost:6379

# --- MinIO (parité locale de Cloudflare R2, voir docker-compose.yml) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=kale
MINIO_SECRET_KEY=kale_dev_secret
MINIO_BUCKET=kale-media
MINIO_PUBLIC_URL=http://localhost:9000

# --- Cloudflare R2 (prod — gratuit jusqu'à 10 Go) ---
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_ACCESS_KEY_SECRET=
# R2_BUCKET=kale-media
# R2_PUBLIC_URL=https://media.kale.example.com

# --- SMS OTP ---
# Adapters : fake | termii
SMS_PROVIDER=fake
# SMS_PROVIDER=termii
# TERMII_API_KEY=
# TERMII_SENDER_ID=KALE

# --- FCM (push — gratuit) ---
# FCM_SERVICE_ACCOUNT_JSON=

# --- Tiers gratuits ---
# NEON_DATABASE_URL=   (Postgres managé gratuit)
# UPSTASH_REDIS_URL=   (Redis managé gratuit)
