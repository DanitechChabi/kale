{
  "name": "edureleve-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API EduRelevé — Express, PostgreSQL, Prisma",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "postinstall": "prisma generate",
    "prisma:seed": "prisma db seed",
    "test:db": "node scripts/preparer-base-test.js && vitest run -c vitest.db.config.js"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "morgan": "^1.10.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "prisma": "6.19.3",
    "supertest": "^7.1.4",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  },
  "prisma": {
    "seed": "node --env-file-if-exists=.env prisma/seed.js"
  }
}
