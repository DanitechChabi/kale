# --- Serveur ---
NODE_ENV=development
PORT=4000

# --- Base de données (correspond au docker-compose.yml de la racine) ---
DATABASE_URL=postgresql://edureleve:edureleve@localhost:5432/edureleve?schema=public

# --- JWT : jeton d'accès court + jeton de rafraîchissement long ---
# En production, générer des secrets forts : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=changer-moi-secret-acces-de-developpement-32-caracteres-min
JWT_REFRESH_SECRET=changer-moi-secret-rafraichissement-de-dev-32-caracteres-min
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# --- CORS : origines autorisées, séparées par des virgules ---
CORS_ORIGINES=http://localhost:5173

# --- URL publique du frontend (utilisée dans les QR codes de vérification) ---
URL_PUBLIQUE_FRONTEND=http://localhost:5173

# --- Dossier où sont stockés les PDF archivés (relevés, bulletins) ---
DOSSIER_STOCKAGE=./stockage
