# --- Serveur ---
NODE_ENV=development
PORT=4000

# --- Base de données (correspond au docker-compose.yml de la racine) ---
DATABASE_URL=postgresql://edureleve:edureleve@localhost:5433/edureleve?schema=public

# --- JWT : jeton d'accès court + jeton de rafraîchissement long ---
# En production, générer des secrets forts : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=changer-moi-secret-acces-de-developpement-32-caracteres-min
JWT_REFRESH_SECRET=changer-moi-secret-rafraichissement-de-dev-32-caracteres-min
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# --- CORS : origines autorisées, séparées par des virgules ---
CORS_ORIGINES=http://localhost:5173

# --- URL publique du frontend (utilisée dans les QR codes de vérification) ---
URL_PUBLIQUE_FRONTEND=http://localhost:5173

# --- Stockage des fichiers (pièces, PDF archivés) ---
# « disque » : dossier DOSSIER_STOCKAGE ; « base » : dans PostgreSQL (défaut en production,
# indispensable sur un hébergement dont le disque est effacé à chaque redéploiement)
STOCKAGE=disque
DOSSIER_STOCKAGE=./stockage

# --- Cookie de session (jeton de rafraîchissement) ---
# COOKIE_SECURE=true en production (HTTPS). « none » exige COOKIE_SECURE=true.
COOKIE_SECURE=false
COOKIE_SAMESITE=strict

# --- Limites ---
TAILLE_MAX_DOCUMENT_MO=5
LIMITE_CONNEXION=10
LIMITE_INSCRIPTION=5
# Vérifications publiques de documents par adresse IP et par minute
LIMITE_VERIFICATION=60
# Demandes de duplicata par adresse IP et par heure
LIMITE_DUPLICATA=5
