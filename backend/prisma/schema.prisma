// =============================================================================
// Schéma de base de données d'EduRelevé
//
// Conventions :
// - Modèles et champs en français (camelCase côté code), tables et colonnes en
//   snake_case côté PostgreSQL (@@map / @map).
// - Identifiants UUID, dates en timestamptz.
// - Multi-tenant : chaque table métier porte un ecole_id, toujours indexé.
//   Seuls les référentiels nationaux (départements, communes) n'en ont pas.
// - Les suppressions en cascade sont interdites sur les données scolaires
//   (onDelete: Restrict) : on n'efface jamais un élève, une note ou un relevé
//   par effet de bord.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Énumérations
// -----------------------------------------------------------------------------

enum Role {
  SUPER_ADMIN
  MINISTERE
  ADMIN_ECOLE
  SECRETARIAT
  ENSEIGNANT
  ELEVE
  PARENT
}

/// Statut juridique de l'établissement
enum StatutEcole {
  PUBLIC
  PRIVE_LAIC
  PRIVE_CONFESSIONNEL
}

/// Nature de l'établissement
enum TypeEtablissement {
  CEG // collège d'enseignement général (premier cycle)
  LYCEE // lycée d'enseignement général
  LYCEE_TECHNIQUE // lycée technique et professionnel
  COMPLEXE_SCOLAIRE // établissement privé couvrant plusieurs ordres ou cycles
}

/// Ordre d'enseignement : général ou technique
enum OrdreEnseignement {
  GENERAL
  TECHNIQUE
}

/// Vérification de l'établissement avant activation de son compte
enum StatutVerification {
  EN_ATTENTE // dossier déposé, pas encore examiné
  EN_EXAMEN // en cours d'examen
  VERIFIEE // établissement actif
  REJETEE // dossier refusé (motif obligatoire)
  SUSPENDUE // accès suspendu après vérification
}

/// Pièces du dossier de vérification d'un établissement
enum TypeDocumentEcole {
  AUTORISATION_CREATION_OUVERTURE // arrêté d'autorisation de création et d'ouverture (privé)
  AUTORISATION_DIRIGER // autorisation de diriger du chef d'établissement (privé)
  ACTE_NOMINATION_CHEF // acte de nomination du directeur / proviseur (public)
  PIECE_IDENTITE_RESPONSABLE // pièce d'identité du responsable du compte
  LETTRE_MANDAT // lettre désignant le responsable du compte sur la plateforme
  AUTRE
}

enum StatutDocument {
  EN_ATTENTE
  ACCEPTE
  REFUSE
}

/// Statut d'un élève lors d'un appel
enum StatutPresence {
  PRESENT
  ABSENT
  RETARD
}

/// Découpage de l'année : trimestres ou semestres selon l'établissement
enum TypePeriode {
  TRIMESTRE
  SEMESTRE
}

/// Niveaux de l'enseignement secondaire (6e à 3e : premier cycle ; 2nde à Tle : second cycle)
enum Niveau {
  SIXIEME
  CINQUIEME
  QUATRIEME
  TROISIEME
  SECONDE
  PREMIERE
  TERMINALE
}

enum Sexe {
  M
  F
}

enum StatutInscription {
  INSCRIT
  TRANSFERE
  ABANDON
  EXCLU
}

enum LienParente {
  PERE
  MERE
  TUTEUR
  AUTRE
}

/// Nature d'une évaluation (sert au calcul des moyennes en phase 5)
enum TypeEvaluation {
  INTERROGATION
  DEVOIR
  COMPOSITION
}

/// Type de document officiel archivé
enum TypeDocument {
  BULLETIN_PERIODE // bulletin d'un trimestre / semestre
  RELEVE_ANNUEL // relevé de notes de toute l'année
}

enum StatutDemande {
  EN_ATTENTE // déposée, pas encore examinée
  EN_COURS // prise en charge par le secrétariat
  REJETEE // refusée (motif obligatoire)
  DELIVREE // document mis à disposition
}

enum TypeCours {
  DOCUMENT // fichier PDF déposé
  VIDEO // lien vers une vidéo (YouTube…)
  LIEN // autre ressource en ligne
}

enum ConfianceProgramme {
  OFFICIEL // texte officiel du ministère consulté
  RECOUPE // plusieurs sources concordantes (guides, manuels, épreuves)
  RECONSTITUE // reconstitué à partir des progressions et épreuves, à faire valider
}

enum StatutAbonnement {
  EN_ATTENTE
  ACTIF
  ECHEC
}

enum TypeNotification {
  ABSENCE // absence ou retard relevé à l'appel
  BULLETIN // bulletin ou relevé délivré
  RECAP_NOTES // récapitulatif mensuel des notes
}

enum StatutNotification {
  EN_ATTENTE
  ENVOI // pris en charge par un envoi en cours
  ENVOYEE
  ECHEC // abandonnée après plusieurs tentatives
}

enum ActionAudit {
  CREATION
  MODIFICATION
  SUPPRESSION
}

// -----------------------------------------------------------------------------
// Référentiel géographique national (sans ecole_id)
// -----------------------------------------------------------------------------

/// Les 12 départements du Bénin
model Departement {
  id       String    @id @default(uuid()) @db.Uuid
  code     String    @unique @db.VarChar(10) // ex. « ATL » pour Atlantique
  nom      String    @unique @db.VarChar(80)
  communes Commune[]

  @@map("departements")
}

/// Les 77 communes du Bénin
model Commune {
  id            String      @id @default(uuid()) @db.Uuid
  nom           String      @db.VarChar(80)
  departementId String      @map("departement_id") @db.Uuid
  departement   Departement @relation(fields: [departementId], references: [id], onDelete: Restrict)
  ecoles        Ecole[]

  @@unique([departementId, nom])
  @@index([departementId])
  @@map("communes")
}

// -----------------------------------------------------------------------------
// Référentiel pédagogique national (sans ecole_id)
// Sert à proposer les matières et coefficients par défaut à la création d'une
// classe. Modifiable par le ministère ; chaque ligne indique si elle a été
// vérifiée sur un texte officiel.
// -----------------------------------------------------------------------------

/// Séries du second cycle : A1, A2, B, C, D (général) ; E, F1-F4, G1-G3 (technique)
model Serie {
  id      String            @id @default(uuid()) @db.Uuid
  code    String            @unique @db.VarChar(10)
  libelle String            @db.VarChar(100) // ex. « Biologie - Géologie »
  ordre   OrdreEnseignement
  actif   Boolean           @default(true)

  programmes ProgrammeMatiere[]
  classes    Classe[]

  @@map("series")
}

/// Catalogue national des disciplines (le ministère peut en ajouter)
model MatiereReference {
  id             String  @id @default(uuid()) @db.Uuid
  code           String  @unique @db.VarChar(20) // ex. « PCT », « SVT », « LV2-ALL »
  nom            String  @db.VarChar(100)
  nomCourt       String  @map("nom_court") @db.VarChar(20) // affichage sur le bulletin
  ordreAffichage Int     @default(0) @map("ordre_affichage") @db.SmallInt
  actif          Boolean @default(true)

  programmes ProgrammeMatiere[]
  matieres   Matiere[]

  @@map("matieres_reference")
}

/// Programme officiel : matières d'un niveau (et d'une série au second cycle)
/// avec coefficient et volume horaire par défaut.
/// Unicité (niveau, série, matière) assurée par un index NULLS NOT DISTINCT
/// dans la migration (la série est vide au premier cycle).
model ProgrammeMatiere {
  id                 String   @id @default(uuid()) @db.Uuid
  niveau             Niveau
  serieId            String?  @map("serie_id") @db.Uuid
  matiereReferenceId String   @map("matiere_reference_id") @db.Uuid
  coefficient        Int      @db.SmallInt
  /// Heures de cours par semaine
  heuresHebdo        Decimal? @map("heures_hebdo") @db.Decimal(3, 1)
  /// Matières au choix : l'élève en suit une seule par groupe (ex. « LV2 »)
  groupeOption       String?  @map("groupe_option") @db.VarChar(30)
  /// Faux tant que la ligne n'a pas été confirmée sur un texte officiel
  /// Matière facultative : suivie seulement par les élèves qui la choisissent ;
  /// seuls les points au-dessus de 10 comptent dans la moyenne (bonus)
  estFacultative     Boolean  @default(false) @map("est_facultative")
  estVerifie         Boolean  @default(false) @map("est_verifie")
  source             String?  @db.VarChar(255)

  serie            Serie?           @relation(fields: [serieId], references: [id], onDelete: Restrict)
  matiereReference MatiereReference @relation(fields: [matiereReferenceId], references: [id], onDelete: Restrict)

  @@index([niveau, serieId])
  @@map("programmes_matieres")
}

// -----------------------------------------------------------------------------
// Établissements et utilisateurs
// -----------------------------------------------------------------------------

model Ecole {
  id                   String              @id @default(uuid()) @db.Uuid
  code                 String              @unique @db.VarChar(30) // code officiel de l'établissement
  nom                  String              @db.VarChar(200)
  sigle                String?             @db.VarChar(30)
  statut               StatutEcole
  type                 TypeEtablissement
  /// Ordres d'enseignement proposés (général, technique ou les deux)
  ordres               OrdreEnseignement[]
  nomChefEtablissement String?             @map("nom_chef_etablissement") @db.VarChar(200)
  communeId            String              @map("commune_id") @db.Uuid
  adresse              String?             @db.VarChar(255)
  telephone            String?             @db.VarChar(30)
  email                String?             @db.VarChar(255)
  /// Type de découpage de l'année appliqué par l'établissement
  typePeriode          TypePeriode         @default(TRIMESTRE) @map("type_periode")
  /// Notifications SMS aux parents (activables par l'établissement)
  smsAbsences          Boolean             @default(true) @map("sms_absences")
  smsBulletins         Boolean             @default(true) @map("sms_bulletins")
  smsRecapNotes        Boolean             @default(true) @map("sms_recap_notes")
  /// Un établissement n'accède à la plateforme qu'une fois VERIFIEE
  statutVerification   StatutVerification  @default(EN_ATTENTE) @map("statut_verification")
  verifieeLe           DateTime?           @map("verifiee_le") @db.Timestamptz(3)
  verifieeParId        String?             @map("verifiee_par_id") @db.Uuid
  motifDecision        String?             @map("motif_decision") @db.VarChar(500)
  actif                Boolean             @default(true)
  creeLe               DateTime            @default(now()) @map("cree_le") @db.Timestamptz(3)
  modifieLe            DateTime            @updatedAt @map("modifie_le") @db.Timestamptz(3)

  commune           Commune                @relation(fields: [communeId], references: [id], onDelete: Restrict)
  verifieePar       Utilisateur?           @relation("VerificationEcole", fields: [verifieeParId], references: [id], onDelete: Restrict)
  documents         DocumentEcole[]
  utilisateurs      Utilisateur[]
  anneesScolaires   AnneeScolaire[]
  periodes          Periode[]
  classes           Classe[]
  matieres          Matiere[]
  enseignements     Enseignement[]
  eleves            Eleve[]
  liensParentEleve  LienParentEleve[]
  inscriptions      Inscription[]
  evaluations       Evaluation[]
  notes             Note[]
  creneaux          CreneauEmploiDuTemps[]
  choixOptions      ChoixOption[]
  appels            Appel[]
  presences         Presence[]
  relevesArchives   ReleveArchive[]
  demandesDuplicata DemandeDuplicata[]
  journalAudit      JournalAudit[]
  notifications     Notification[]
  cours             Cours[]
  devoirs           Devoir[]
  devoirsFaits      DevoirFait[]
  rendus            RenduDevoir[]
  rendusFichiers    RenduFichier[]

  @@index([communeId])
  @@index([statutVerification])
  @@map("ecoles")
}

/// Pièce justificative déposée par l'établissement pour sa vérification.
model DocumentEcole {
  id              String            @id @default(uuid()) @db.Uuid
  ecoleId         String            @map("ecole_id") @db.Uuid
  type            TypeDocumentEcole
  /// Référence portée par l'acte (ex. n° d'arrêté)
  referenceActe   String?           @map("reference_acte") @db.VarChar(100)
  dateActe        DateTime?         @map("date_acte") @db.Date
  nomFichier      String            @map("nom_fichier") @db.VarChar(255)
  cheminFichier   String            @map("chemin_fichier") @db.VarChar(500)
  typeMime        String            @map("type_mime") @db.VarChar(100)
  tailleOctets    Int               @map("taille_octets")
  empreinteSha256 String            @map("empreinte_sha256") @db.Char(64)
  statut          StatutDocument    @default(EN_ATTENTE)
  commentaire     String?           @db.VarChar(500)
  deposeParId     String?           @map("depose_par_id") @db.Uuid
  deposeLe        DateTime          @default(now()) @map("depose_le") @db.Timestamptz(3)
  examineParId    String?           @map("examine_par_id") @db.Uuid
  examineLe       DateTime?         @map("examine_le") @db.Timestamptz(3)

  ecole      Ecole        @relation(fields: [ecoleId], references: [id], onDelete: Restrict)
  deposePar  Utilisateur? @relation("DocumentDepose", fields: [deposeParId], references: [id], onDelete: SetNull)
  examinePar Utilisateur? @relation("DocumentExamine", fields: [examineParId], references: [id], onDelete: Restrict)

  @@index([ecoleId])
  @@map("documents_ecoles")
}

/// Compte de connexion. Les comptes d'un établissement restent inactifs tant
/// que celui-ci n'est pas vérifié. ecole_id est obligatoire pour les rôles d'établissement
/// (ADMIN_ECOLE, SECRETARIAT, ENSEIGNANT, ELEVE) et vide pour SUPER_ADMIN,
/// MINISTERE et PARENT (un parent peut avoir des enfants dans plusieurs écoles).
/// Cette règle est vérifiée par une contrainte CHECK dans la migration.
model Utilisateur {
  id                    String    @id @default(uuid()) @db.Uuid
  ecoleId               String?   @map("ecole_id") @db.Uuid
  role                  Role
  nom                   String    @db.VarChar(100)
  prenoms               String    @db.VarChar(150)
  /// Identifiants de connexion : au moins un des deux (contrainte CHECK),
  /// sauf pour un élève, qui se connecte avec son identifiant EduRelevé
  email                 String?   @unique @db.VarChar(255)
  telephone             String?   @unique @db.VarChar(30)
  motDePasseHash        String    @map("mot_de_passe_hash") @db.VarChar(255)
  doitChangerMotDePasse Boolean   @default(true) @map("doit_changer_mot_de_passe")
  actif                 Boolean   @default(true)
  derniereConnexionLe   DateTime? @map("derniere_connexion_le") @db.Timestamptz(3)
  creeLe                DateTime  @default(now()) @map("cree_le") @db.Timestamptz(3)
  modifieLe             DateTime  @updatedAt @map("modifie_le") @db.Timestamptz(3)

  ecole                  Ecole?                  @relation(fields: [ecoleId], references: [id], onDelete: Restrict)
  /// Fiche élève associée (rôle ELEVE uniquement)
  eleve                  Eleve?
  jetonsRafraichissement JetonRafraichissement[]
  enfants                LienParentEleve[]
  enseignements          Enseignement[]
  classesPrincipales     Classe[]                @relation("ProfesseurPrincipal")
  periodesCloturees      Periode[]               @relation("ClotureePar")
  evaluationsCreees      Evaluation[]
  notesSaisies           Note[]
  appelsFaits            Appel[]
  presencesJustifiees    Presence[]              @relation("JustifieePar")
  ecolesVerifiees        Ecole[]                 @relation("VerificationEcole")
  documentsDeposes       DocumentEcole[]         @relation("DocumentDepose")
  documentsExamines      DocumentEcole[]         @relation("DocumentExamine")
  relevesGeneres         ReleveArchive[]
  demandesDeposees       DemandeDuplicata[]      @relation("Demandeur")
  demandesTraitees       DemandeDuplicata[]      @relation("TraitePar")
  notifications          Notification[]
  coursPublies           Cours[]
  devoirsDonnes          Devoir[]
  profilsEduCourses      EcProfil[]
  abonnementsEduCourses  EcAbonnement[]
  actionsAudit           JournalAudit[]

  @@index([ecoleId])
  @@index([role])
  @@map("utilisateurs")
}

/// Jetons de rafraîchissement JWT. Seule l'empreinte SHA-256 du jeton est stockée.
model JetonRafraichissement {
  id               String    @id @default(uuid()) @db.Uuid
  utilisateurId    String    @map("utilisateur_id") @db.Uuid
  empreinte        String    @unique @db.Char(64)
  expireLe         DateTime  @map("expire_le") @db.Timestamptz(3)
  revoqueLe        DateTime? @map("revoque_le") @db.Timestamptz(3)
  /// Jeton émis en remplacement lors d'une rotation (détection de réutilisation)
  remplaceParId    String?   @map("remplace_par_id") @db.Uuid
  agentUtilisateur String?   @map("agent_utilisateur") @db.VarChar(255)
  adresseIp        String?   @map("adresse_ip") @db.VarChar(45)
  creeLe           DateTime  @default(now()) @map("cree_le") @db.Timestamptz(3)

  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@index([utilisateurId])
  @@map("jetons_rafraichissement")
}

// -----------------------------------------------------------------------------
// Organisation de l'année scolaire
// -----------------------------------------------------------------------------

model AnneeScolaire {
  id          String   @id @default(uuid()) @db.Uuid
  ecoleId     String   @map("ecole_id") @db.Uuid
  libelle     String   @db.VarChar(9) // ex. « 2025-2026 »
  dateDebut   DateTime @map("date_debut") @db.Date
  dateFin     DateTime @map("date_fin") @db.Date
  /// Année en cours pour l'établissement (une seule à la fois, index partiel)
  estCourante Boolean  @default(false) @map("est_courante")
  creeLe      DateTime @default(now()) @map("cree_le") @db.Timestamptz(3)

  ecole             Ecole              @relation(fields: [ecoleId], references: [id], onDelete: Restrict)
  periodes          Periode[]
  classes           Classe[]
  inscriptions      Inscription[]
  relevesArchives   ReleveArchive[]
  demandesDuplicata DemandeDuplicata[]

  @@unique([ecoleId, libelle])
  @@index([ecoleId])
  @@map("annees_scolaires")
}

/// Trimestre ou semestre. Une fois clôturé, ses notes ne sont plus modifiables
/// (contrôlé par l'application ET par un trigger PostgreSQL).
model Periode {
  id              String      @id @default(uuid()) @db.Uuid
  ecoleId         String      @map("ecole_id") @db.Uuid
  anneeScolaireId String      @map("annee_scolaire_id") @db.Uuid
  type            TypePeriode
  numero          Int         @db.SmallInt // 1, 2, 3 (trimestres) ou 1, 2 (semestres)
  dateDebut       DateTime    @map("date_debut") @db.Date
  dateFin         DateTime    @map("date_fin") @db.Date
  estCloturee     Boolean     @default(false) @map("est_cloturee")
  clotureeLe      DateTime?   @map("cloturee_le") @db.Timestamptz(3)
  clotureeParId   String?     @map("cloturee_par_id") @db.Uuid

  ecole           Ecole           @relation(fields: [ecoleId], references: [id], onDelete: Restrict)
  anneeScolaire   AnneeScolaire   @relation(fields: [anneeScolaireId], references: [id], onDelete: Restrict)
  clotureePar     Utilisateur?    @relation("ClotureePar", fields: [clotureeParId], references: [id], onDelete: Restrict)
  evaluations     Evaluation[]
  relevesArchives ReleveArchive[]

  @@unique([anneeScolaireId, numero])
  @@index([ecoleId])
  @@map("periodes")
}

model Classe {
  id                    String   @id @default(uuid()) @db.Uuid
  ecoleId               String   @map("ecole_id") @db.Uuid
  anneeScolaireId       String   @map("annee_scolaire_id") @db.Uuid
  niveau                Niveau
  /// Obligatoire au second cycle, vide au premier cycle (contrainte CHECK)
  serieId               String?  @map("serie_id") @db.Uuid
  nom                   String   @db.VarChar(50) // ex. « 6e A », « Tle D 2 »
  professeurPrincipalId String?  @map("professeur_principal_id") @db.Uuid
  creeLe                DateTime @default(now()) @map("cree_le") @db.Timestamptz(3)
  modifieLe             DateTime @updatedAt @map("modifie_le") @db.Timestamptz(3)

  ecole               Ecole                  @relation(fields: [ecoleId], references: [id], onDelete: Restrict)
  anneeScolaire       AnneeScolaire          @relation(fields: [anneeScolaireId], references: [id], onDelete: Restrict)
  serie               Serie?                 @relation(fields: [serieId], references: [id], onDelete: Restrict)
  professeurPrincipal Utilisateur?           @relation("ProfesseurPrincipal", fields: [professeurPrincipalId], references: [id], onDelete: SetNull)
  enseignements       Enseignement[]
  inscriptions        Inscription[]
  creneaux            CreneauEmploiDuTemps[]
  appels              Appel[]

  @@unique([anneeScolaireId, nom])
  @@index([ecoleId])
  @@map("classes")
}

/// Matière telle qu'enseignée dans l'établissement. Rattachée au catalogue
/// national quand elle en provient ; sinon matière ajoutée par l'établissement
/// (matiere_reference_id vide), par exemple une option locale.
model Matiere {
  id                 String  @id @default(uuid()) @db.Uuid
  ecoleId            String  @map("ecole_id") @db.Uuid
  matiereReferenceId String? @map("matiere_reference_id") @db.Uuid
  code               String  @db.VarChar(20) // ex. « MATH », « FR », « SVT »
  nom                String  @db.VarChar(100)
  actif              Boolean @default(true)

  ecole            Ecole             @relation(fields: [ecoleId], references: [id], onDelete: Restrict)
  matiereReference MatiereReference? @relation(fields: [matiereReferenceId], references: [id], onDelete: Restrict)
  enseignements    Enseignement[]

  @@unique([ecoleId, code])
  @@index([ecoleId])
  @@map("matieres")
}

/// Une matière enseignée dans une classe : porte le coefficient et l'enseignant.
/// Créée automatiquement depuis le programme officiel à la création de la
/// classe, puis ajustable par l'établissement.
model Enseignement {
  id             String   @id @default(uuid()) @db.Uuid
  ecoleId        String   @map("ecole_id") @db.Uuid
  classeId       String   @map("classe_id") @db.Uuid
  matiereId      String   @map("matiere_id") @db.Uuid
  coefficient    Int      @db.SmallInt // > 0 (contrainte CHECK)
  heuresHebdo    Decimal? @map("heures_hebdo") @db.Decimal(3, 1)
  /// Copié du programme : matières au choix (ex. « LV2 »)
  groupeOption   String?  @map("groupe_option") @db.VarChar(30)
  /// Copié du programme ; voir ProgrammeMatiere.estFacultative
  estFacultative Boolean  @default(false) @map("est_facultative")
  enseignantId   String?  @map("enseignant_id") @db.Uuid

  ecole        Ecole                  @relation(fields: [ecoleId], references: [id], onDelete: Restrict)
  classe       Classe                 @relation(fields: [classeId], references: [id], onDelete: Restrict)
  matiere      Matiere                @relation(fields: [matiereId], references: [id], onDelete: Restrict)
  enseignant   Utilisateur?           @relation(fields: [enseignantId], references: [id], onDelete: SetNull)
  evaluations  Evaluation[]
  creneaux     CreneauEmploiDuTemps[]
  choixOptions ChoixOption[]
  appels       Appel[]
  cours        Cours[]
  devoirs      Devoir[]

  @@unique([classeId, matiereId])
  @@index([ecoleId])
  @@index([enseignantId])
  @@map("enseignements")
}

// -----------------------------------------------------------------------------
// Élèves, parents, inscriptions
// -----------------------------------------------------------------------------

model Eleve {
  id                     String   @id @default(uuid()) @db.Uuid
  ecoleId                String   @map("ecole_id") @db.Uuid
  matricule              String   @db.VarChar(30) // unique dans l'établissement
  /// Identifiant EduRelevé : unique dans tout le pays, avec caractère de contrôle,
  /// suit l'élève d'un établissement à l'autre et lui sert d'identifiant de connexion
  identifiant            String   @unique @db.VarChar(10)
  /// Numéro personnel d'identification (futur lien avec les registres de l'État)
  npi                    String?  @db.VarChar(20)
  nom                    String   @db.VarChar(100)
  prenoms                String   @db.VarChar(150)
  sexe                   Sexe
  dateNaissance          DateTime @map("date_naissance") @db.Date
  lieuNaissance          String?  @map("lieu_naissance") @db.VarChar(100)
  /// Contact du parent ou tuteur (utile même sans compte : notifications par SMS)
  nomContactParent       String?  @map("nom_contact_parent") @db.VarChar(200)
  telephoneContactParent String?  @map("telephone_contact_parent") @db.VarChar(30)
  /// Compte de connexion de l'élève (facultatif)
  utilisateurId          String?  @unique @map("utilisateur_id") @db.Uuid
  creeLe                 DateTime @default(now()) @map("cree_le") @db.Timestamptz(3)
  modifieLe              DateTime @updatedAt @map("modifie_le") @db.Timestamptz(3)

  ecole             Ecole              @relation(fields: [ecoleId], references: [id], onDelete: Restrict)
  utilisateur       Utilisateur?       @relation(fields: [utilisateurId], references: [id], onDelete: SetNull)
  parents           LienParentEleve[]
  inscriptions      Inscription[]
  notes             Note[]
  presences         Presence[]
  relevesArchives   ReleveArchive[]
  demandesDuplicata DemandeDuplicata[]
  notifications     Notification[]
  devoirsFaits      DevoirFait[]
  rendus            RenduDevoir[]

  @@unique([ecoleId, matricule])
  @@unique([ecoleId, npi])
  @@index([npi])
  @@index([ecoleId, nom, prenoms])
  @@map("eleves")
}

model LienParentEleve {
  id       String      @id @default(uuid()) @db.Uuid
  ecoleId  String      @map("ecole_id") @db.Uuid // école de l'élève
  parentId String      @map("parent_id") @db.Uuid
  eleveId  String      @map("eleve_id") @db.Uuid
  lien     LienParente
  creeLe   DateTime    @default(now()) @map("cree_le") @db.Timestamptz(3)

  ecole  Ecole       @relation(fields: [ecoleId], references: [id], onDelete: Restrict)
  parent Utilisateur @relation(fields: [parentId], references: [id], onDelete: Restrict)
  eleve  Eleve       @relation(fields: [eleveId], references: [id], onDelete: Restrict)

  @@unique([parentId, eleveId])
  @@index([ecoleId])
  @@index([eleveId])
  @@map("liens_parent_eleve")
}

/// Inscription d'un élève dans une classe pour une année (une seule par année).
model Inscription {
  id              String            @id @default(uuid()) @db.Uuid
  ecoleId         String            @map("ecole_id") @db.Uuid
  eleveId         String            @map("eleve_id") @db.Uuid
  classeId        String            @map("classe_id") @db.Uuid
  anneeScolaireId String            @map("annee_scolaire_id") @db.Uuid
  statut          StatutInscription @default(INSCRIT)
  redoublant      Boolean           @default(false)
  dateInscription DateTime          @default(now()) @map("date_inscription") @db.Date
  creeLe          DateTime          @default(now()) @map("cree_le") @db.Timestamptz(3)
  modifieLe       DateTime          @updatedAt @map("modifie_le") @db.Timestamptz(3)

  ecole         Ecole         @relation(fields: [ecoleId], references: [id], onDelete: Restrict)
  eleve         Eleve         @relation(fields: [eleveId], references: [id], onDelete: Restrict)
  classe        Classe        @relation(fields: [classeId], references: [id], onDelete: Restrict)
  anneeScolaire AnneeScolaire @relation(fields: [anneeScolaireId], references: [id], onDelete: Restrict)
  choixOptions  ChoixOption[]

  @@unique([eleveId, anneeScolaireId])
  @@index([ecoleId])
  @@index([classeId])
  @@map("inscriptions")
}

/// Matière choisie par l'élève : une matière d'un groupe d'options (ex. LV2 :
/// allemand ou espagnol) ou une matière facultative.
model ChoixOption {
  id             String @id @default(uuid()) @db.Uuid
  ecoleId        String @map("ecole_id") @db.Uuid
  inscriptionId  String @map("inscription_id") @db.Uuid
  enseignementId String @map("enseignement_id") @db.Uuid

  ecole        Ecole        @relation(fields: [ecoleId], references: [id], onDelete: Restrict)
  inscription  Inscription  @relation(fields: [inscriptionId], references: [id], onDelete: Restrict)
  enseignement Enseignement @relation(fields: [enseignementId], references: [id], onDelete: Restrict)

  @@unique([inscriptionId, enseignementId])
  @@index([ecoleId])
  @@map("choix_options")
}

// -----------------------------------------------------------------------------
// Emploi du temps et présences
// -----------------------------------------------------------------------------

/// Créneau hebdomadaire récurrent de l'emploi du temps d'une classe.
/// Les chevauchements (classe, enseignant, salle) sont refusés par l'application.
model CreneauEmploiDuTemps {
  id             String    @id @default(uuid()) @db.Uuid
  ecoleId        String    @map("ecole_id") @db.Uuid
  classeId       String    @map("classe_id") @db.Uuid
  enseignementId String    @map("enseignement_id") @db.Uuid
  /// 1 = lundi … 6 = samedi
  jour           Int       @db.SmallInt
  heureDebut     DateTime  @map("heure_debut") @db.Time(0)
  heureFin       DateTime  @map("heure_fin") @db.Time(0)
  salle          String?   @db.VarChar(50)
  /// Période de validité (un emploi du temps peut changer en cours d'année)
  valideDu       DateTime  @map("valide_du") @db.Date
  valideAu       DateTime? @map("valide_au") @db.Date

  ecole        Ecole        @relation(fields: [ecoleId], references: [id], onDelete: Restrict)
  classe       Classe       @relation(fields: [classeId], references: [id], onDelete: Restrict)
  enseignement Enseignement @relation(fields: [enseignementId], references: [id], onDelete: Restrict)
  appels       Appel[]

  @@index([ecoleId])
  @@index([classeId, jour])
  @@map("creneaux_emploi_du_temps")
}

/// Appel fait en début de cours : preuve que la présence a été relevée.
model Appel {
  id             String   @id @default(uuid()) @db.Uuid
  ecoleId        String   @map("ecole_id") @db.Uuid
  classeId       String   @map("classe_id") @db.Uuid
  /// Créneau de l'emploi du temps concerné (vide pour un appel hors emploi du temps)
  creneauId      String?  @map("creneau_id") @db.Uuid
  enseignementId String?  @map("enseignement_id") @db.Uuid
  date           DateTime @db.Date
  heureDebut     DateTime @map("heure_debut") @db.Time(0)
  faitParId      String   @map("fait_par_id") @db.Uuid
  creeLe         DateTime @default(now()) @map("cree_le") @db.Timestamptz(3)

  ecole        Ecole                 @relation(fields: [ecoleId], references: [id], onDelete: Restrict)
  classe       Classe                @relation(fields: [classeId], references: [id], onDelete: Restrict)
  creneau      CreneauEmploiDuTemps? @relation(fields: [creneauId], references: [id], onDelete: Restrict)
  enseignement Enseignement?         @relation(fields: [enseignementId], references: [id], onDelete: Restrict)
  faitPar      Utilisateur           @relation(fields: [faitParId], references: [id], onDelete: Restrict)
  presences    Presence[]

  @@unique([classeId, date, heureDebut])
  @@index([ecoleId, date])
  @@map("appels")
}

/// Ligne du relevé de présence : une par élève inscrit et par appel.
model Presence {
  id             String         @id @default(uuid()) @db.Uuid
  ecoleId        String         @map("ecole_id") @db.Uuid
  appelId        String         @map("appel_id") @db.Uuid
  eleveId        String         @map("eleve_id") @db.Uuid
  statut         StatutPresence
  minutesRetard  Int?           @map("minutes_retard") @db.SmallInt
  justifiee      Boolean        @default(false)
  motif          String?        @db.VarChar(255)
  justifieeParId String?        @map("justifiee_par_id") @db.Uuid
  justifieeLe    DateTime?      @map("justifiee_le") @db.Timestamptz(3)

  ecole        Ecole        @relation(fields: [ecoleId], references: [id], onDelete: Restrict)
  appel        Appel        @relation(fields: [appelId], references: [id], onDelete: Restrict)
  eleve        Eleve        @relation(fields: [eleveId], references: [id], onDelete: Restrict)
  justifieePar Utilisateur? @relation("JustifieePar", fields: [justifieeParId], references: [id], onDelete: Restrict)

  @@unique([appelId, eleveId])
  @@index([ecoleId])
  @@index([eleveId, statut])
  @@map("presences")
}

// -----------------------------------------------------------------------------
// Notes
// -----------------------------------------------------------------------------

/// Une évaluation (interrogation, devoir, composition) dans une matière d'une classe.
model Evaluation {
  id             String         @id @default(uuid()) @db.Uuid
  ecoleId        String         @map("ecole_id") @db.Uuid
  enseignementId String         @map("enseignement_id") @db.Uuid
  periodeId      String         @map("periode_id") @db.Uuid
  type           TypeEvaluation
  libelle        String         @db.VarChar(100) // ex. « Devoir 1 »
  date           DateTime       @db.Date
  bareme         Decimal        @default(20) @db.Decimal(5, 2) // note maximale
  creeParId      String         @map("cree_par_id") @db.Uuid
  creeLe         DateTime       @default(now()) @map("cree_le") @db.Timestamptz(3)

  ecole        Ecole        @relation(fields: [ecoleId], references: [id], onDelete: Restrict)
  enseignement Enseignement @relation(fields: [enseignementId], references: [id], onDelete: Restrict)
  periode      Periode      @relation(fields: [periodeId], references: [id], onDelete: Restrict)
  creePar      Utilisateur  @relation(fields: [creeParId], references: [id], onDelete: Restrict)
  notes        Note[]

  @@index([ecoleId])
  @@index([enseignementId, periodeId])
  @@map("evaluations")
}

/// Note d'un élève à une évaluation. Toute création ou modification est tracée
/// dans journal_audit. Bloquée si la période est clôturée (trigger).
model Note {
  id           String   @id @default(uuid()) @db.Uuid
  ecoleId      String   @map("ecole_id") @db.Uuid
  evaluationId String   @map("evaluation_id") @db.Uuid
  eleveId      String   @map("eleve_id") @db.Uuid
  /// Valeur sur le barème de l'évaluation ; vide si l'élève était absent
  valeur       Decimal? @db.Decimal(5, 2)
  absent       Boolean  @default(false)
  saisieParId  String   @map("saisie_par_id") @db.Uuid
  creeLe       DateTime @default(now()) @map("cree_le") @db.Timestamptz(3)
  modifieLe    DateTime @updatedAt @map("modifie_le") @db.Timestamptz(3)

  ecole      Ecole       @relation(fields: [ecoleId], references: [id], onDelete: Restrict)
  evaluation Evaluation  @relation(fields: [evaluationId], references: [id], onDelete: Restrict)
  eleve      Eleve       @relation(fields: [eleveId], references: [id], onDelete: Restrict)
  saisiePar  Utilisateur @relation(fields: [saisieParId], references: [id], onDelete: Restrict)

  @@unique([evaluationId, eleveId])
  @@index([ecoleId])
  @@index([eleveId])
  @@map("notes")
}

// -----------------------------------------------------------------------------
// Documents officiels archivés et duplicatas
// -----------------------------------------------------------------------------

/// Relevé ou bulletin archivé DÉFINITIVEMENT : jamais modifié ni supprimé
/// (trigger PostgreSQL). Une correction crée un nouveau relevé qui pointe vers
/// l'ancien via remplaceReleveId.
model ReleveArchive {
  id               String       @id @default(uuid()) @db.Uuid
  ecoleId          String       @map("ecole_id") @db.Uuid
  /// Numéro public unique, imprimé sur le PDF et encodé dans le QR code
  numero           String       @unique @db.VarChar(30)
  type             TypeDocument
  eleveId          String       @map("eleve_id") @db.Uuid
  anneeScolaireId  String       @map("annee_scolaire_id") @db.Uuid
  /// Renseigné pour un bulletin de période, vide pour un relevé annuel
  periodeId        String?      @map("periode_id") @db.Uuid
  /// Emplacement du PDF figé dans le stockage
  cheminFichier    String       @map("chemin_fichier") @db.VarChar(500)
  /// Empreinte SHA-256 du PDF (hexadécimal)
  empreinteSha256  String       @unique @map("empreinte_sha256") @db.Char(64)
  tailleOctets     Int          @map("taille_octets")
  /// Instantané des données ayant servi à produire le document (notes, moyennes, rang…)
  donnees          Json
  /// Relevé corrigé par celui-ci (un relevé ne peut être remplacé qu'une fois)
  remplaceReleveId String?      @unique @map("remplace_releve_id") @db.Uuid
  motifCorrection  String?      @map("motif_correction") @db.VarChar(500)
  genereParId      String       @map("genere_par_id") @db.Uuid
  genereLe         DateTime     @default(now()) @map("genere_le") @db.Timestamptz(3)

  ecole             Ecole              @relation(fields: [ecoleId], references: [id], onDelete: Restrict)
  eleve             Eleve              @relation(fields: [eleveId], references: [id], onDelete: Restrict)
  anneeScolaire     AnneeScolaire      @relation(fields: [anneeScolaireId], references: [id], onDelete: Restrict)
  periode           Periode?           @relation(fields: [periodeId], references: [id], onDelete: Restrict)
  generePar         Utilisateur        @relation(fields: [genereParId], references: [id], onDelete: Restrict)
  remplace          ReleveArchive?     @relation("Correction", fields: [remplaceReleveId], references: [id], onDelete: Restrict)
  remplacePar       ReleveArchive?     @relation("Correction")
  demandesDuplicata DemandeDuplicata[]

  @@index([ecoleId])
  @@index([eleveId])
  @@map("releves_archives")
}

/// Demande de duplicata déposée en ligne (par un élève, ancien élève ou parent).
model DemandeDuplicata {
  id               String        @id @default(uuid()) @db.Uuid
  ecoleId          String        @map("ecole_id") @db.Uuid
  /// Numéro de suivi communiqué au demandeur
  numeroSuivi      String        @unique @map("numero_suivi") @db.VarChar(30)
  /// Élève concerné, s'il a été identifié dans la base de l'école
  eleveId          String?       @map("eleve_id") @db.Uuid
  /// Compte du demandeur, s'il en a un
  demandeurId      String?       @map("demandeur_id") @db.Uuid
  /// Identité et contact déclarés (obligatoires même sans compte)
  nomDemandeur     String        @map("nom_demandeur") @db.VarChar(250)
  telephone        String        @db.VarChar(30)
  email            String?       @db.VarChar(255)
  typeDocument     TypeDocument  @map("type_document")
  /// Élève concerné, tel que déclaré par le demandeur
  nomEleve         String        @map("nom_eleve") @db.VarChar(100)
  prenomsEleve     String        @map("prenoms_eleve") @db.VarChar(150)
  dateNaissance    DateTime      @map("date_naissance") @db.Date
  matriculeDeclare String?       @map("matricule_declare") @db.VarChar(30)
  /// Trimestre ou semestre demandé (bulletin de période)
  numeroPeriode    Int?          @map("numero_periode") @db.SmallInt
  /// Année concernée si elle existe dans la base, sinon libellé saisi (ex. « 2012-2013 »)
  anneeScolaireId  String?       @map("annee_scolaire_id") @db.Uuid
  libelleAnnee     String        @map("libelle_annee") @db.VarChar(9)
  classeDeclaree   String?       @map("classe_declaree") @db.VarChar(50)
  motif            String?       @db.VarChar(500)
  statut           StatutDemande @default(EN_ATTENTE)
  motifRejet       String?       @map("motif_rejet") @db.VarChar(500)
  traiteParId      String?       @map("traite_par_id") @db.Uuid
  /// Document délivré
  releveId         String?       @map("releve_id") @db.Uuid
  demandeLe        DateTime      @default(now()) @map("demande_le") @db.Timestamptz(3)
  priseEnChargeLe  DateTime?     @map("prise_en_charge_le") @db.Timestamptz(3)
  clotureLe        DateTime?     @map("cloture_le") @db.Timestamptz(3) // délivrance ou rejet

  ecole         Ecole          @relation(fields: [ecoleId], references: [id], onDelete: Restrict)
  eleve         Eleve?         @relation(fields: [eleveId], references: [id], onDelete: Restrict)
  demandeur     Utilisateur?   @relation("Demandeur", fields: [demandeurId], references: [id], onDelete: SetNull)
  traitePar     Utilisateur?   @relation("TraitePar", fields: [traiteParId], references: [id], onDelete: Restrict)
  anneeScolaire AnneeScolaire? @relation(fields: [anneeScolaireId], references: [id], onDelete: Restrict)
  releve        ReleveArchive? @relation(fields: [releveId], references: [id], onDelete: Restrict)

  @@index([ecoleId, statut])
  @@index([demandeurId])
  @@map("demandes_duplicata")
}

// -----------------------------------------------------------------------------
// Traçabilité
// -----------------------------------------------------------------------------

/// Journal d'audit en ajout seul (UPDATE et DELETE interdits par trigger).
/// Utilisé obligatoirement pour les notes ; extensible aux autres entités.
model JournalAudit {
  id             String      @id @default(uuid()) @db.Uuid
  ecoleId        String?     @map("ecole_id") @db.Uuid
  utilisateurId  String?     @map("utilisateur_id") @db.Uuid
  action         ActionAudit
  entite         String      @db.VarChar(50) // ex. « Note »
  entiteId       String      @map("entite_id") @db.Uuid
  ancienneValeur Json?       @map("ancienne_valeur")
  nouvelleValeur Json?       @map("nouvelle_valeur")
  adresseIp      String?     @map("adresse_ip") @db.VarChar(45)
  creeLe         DateTime    @default(now()) @map("cree_le") @db.Timestamptz(3)

  ecole       Ecole?       @relation(fields: [ecoleId], references: [id], onDelete: Restrict)
  utilisateur Utilisateur? @relation(fields: [utilisateurId], references: [id], onDelete: Restrict)

  @@index([ecoleId, creeLe])
  @@index([entite, entiteId])
  @@map("journal_audit")
}

/// Contenu des fichiers lorsque le stockage est en base (STOCKAGE=base) : les PDF
/// archivés survivent ainsi aux redéploiements d'un hébergement sans disque durable.
/// Table technique, sans ecole_id : seul utils/fichiers.js y accède, par clé.
model FichierStocke {
  cle             String   @id @db.VarChar(500)
  contenu         Bytes
  typeMime        String   @map("type_mime") @db.VarChar(100)
  tailleOctets    Int      @map("taille_octets")
  empreinteSha256 String   @map("empreinte_sha256") @db.Char(64)
  creeLe          DateTime @default(now()) @map("cree_le") @db.Timestamptz(3)

  @@map("fichiers_stockes")
}

/// Notification envoyée par SMS à un parent (file d'envoi : chaque ligne est
/// envoyée une fois par le fournisseur configuré, voir contexts/notifications).
model Notification {
  id             String             @id @default(uuid()) @db.Uuid
  ecoleId        String             @map("ecole_id") @db.Uuid
  eleveId        String             @map("eleve_id") @db.Uuid
  /// Compte parent destinataire, s'il existe (sinon contact déclaré à l'inscription)
  utilisateurId  String?            @map("utilisateur_id") @db.Uuid
  telephone      String             @db.VarChar(30)
  type           TypeNotification
  message        String             @db.VarChar(480)
  statut         StatutNotification @default(EN_ATTENTE)
  /// Idempotence : un même événement ne produit qu'un message par téléphone
  cleUnicite     String             @unique @map("cle_unicite") @db.VarChar(200)
  fournisseur    String?            @db.VarChar(30)
  idExterne      String?            @map("id_externe") @db.VarChar(100)
  tentatives     Int                @default(0) @db.SmallInt
  derniereErreur String?            @map("derniere_erreur") @db.VarChar(300)
  creeLe         DateTime           @default(now()) @map("cree_le") @db.Timestamptz(3)
  envoyeeLe      DateTime?          @map("envoyee_le") @db.Timestamptz(3)

  ecole       Ecole        @relation(fields: [ecoleId], references: [id], onDelete: Restrict)
  eleve       Eleve        @relation(fields: [eleveId], references: [id], onDelete: Restrict)
  utilisateur Utilisateur? @relation(fields: [utilisateurId], references: [id], onDelete: SetNull)

  @@index([ecoleId, creeLe])
  @@index([statut])
  @@index([telephone])
  @@index([utilisateurId])
  @@map("notifications")
}

/// Support de cours publié par l'enseignant pour une classe et une matière.
model Cours {
  id              String    @id @default(uuid()) @db.Uuid
  ecoleId         String    @map("ecole_id") @db.Uuid
  enseignementId  String    @map("enseignement_id") @db.Uuid
  auteurId        String?   @map("auteur_id") @db.Uuid
  titre           String    @db.VarChar(150)
  description     String?   @db.VarChar(2000)
  type            TypeCours
  /// Vidéo ou lien (https uniquement)
  url             String?   @db.VarChar(500)
  /// Document déposé (contenu contrôlé par signature)
  nomFichier      String?   @map("nom_fichier") @db.VarChar(255)
  cheminFichier   String?   @map("chemin_fichier") @db.VarChar(500)
  typeMime        String?   @map("type_mime") @db.VarChar(100)
  tailleOctets    Int?      @map("taille_octets")
  empreinteSha256 String?   @map("empreinte_sha256") @db.Char(64)
  publieLe        DateTime  @default(now()) @map("publie_le") @db.Timestamptz(3)
  modifieLe       DateTime  @updatedAt @map("modifie_le") @db.Timestamptz(3)

  ecole        Ecole        @relation(fields: [ecoleId], references: [id], onDelete: Restrict)
  enseignement Enseignement @relation(fields: [enseignementId], references: [id], onDelete: Restrict)
  auteur       Utilisateur? @relation(fields: [auteurId], references: [id], onDelete: SetNull)

  @@index([ecoleId])
  @@index([enseignementId, publieLe])
  @@map("cours")
}

/// Devoir à faire (cahier de textes), avec pièce jointe facultative.
model Devoir {
  id              String   @id @default(uuid()) @db.Uuid
  ecoleId         String   @map("ecole_id") @db.Uuid
  enseignementId  String   @map("enseignement_id") @db.Uuid
  auteurId        String?  @map("auteur_id") @db.Uuid
  titre           String   @db.VarChar(150)
  consignes       String   @db.VarChar(4000)
  /// Date à laquelle le travail est attendu
  pourLe          DateTime @map("pour_le") @db.Date
  nomFichier      String?  @map("nom_fichier") @db.VarChar(255)
  cheminFichier   String?  @map("chemin_fichier") @db.VarChar(500)
  typeMime        String?  @map("type_mime") @db.VarChar(100)
  tailleOctets    Int?     @map("taille_octets")
  empreinteSha256 String?  @map("empreinte_sha256") @db.Char(64)
  creeLe          DateTime @default(now()) @map("cree_le") @db.Timestamptz(3)
  modifieLe       DateTime @updatedAt @map("modifie_le") @db.Timestamptz(3)

  ecole        Ecole         @relation(fields: [ecoleId], references: [id], onDelete: Restrict)
  enseignement Enseignement  @relation(fields: [enseignementId], references: [id], onDelete: Restrict)
  auteur       Utilisateur?  @relation(fields: [auteurId], references: [id], onDelete: SetNull)
  faits        DevoirFait[]
  rendus       RenduDevoir[]

  @@index([ecoleId])
  @@index([enseignementId, pourLe])
  @@map("devoirs")
}

/// Devoir marqué « fait » par l'élève (visible par ses parents et l'enseignant).
model DevoirFait {
  id       String   @id @default(uuid()) @db.Uuid
  ecoleId  String   @map("ecole_id") @db.Uuid
  devoirId String   @map("devoir_id") @db.Uuid
  eleveId  String   @map("eleve_id") @db.Uuid
  faitLe   DateTime @default(now()) @map("fait_le") @db.Timestamptz(3)

  ecole  Ecole  @relation(fields: [ecoleId], references: [id], onDelete: Restrict)
  devoir Devoir @relation(fields: [devoirId], references: [id], onDelete: Cascade)
  eleve  Eleve  @relation(fields: [eleveId], references: [id], onDelete: Restrict)

  @@unique([devoirId, eleveId])
  @@index([ecoleId])
  @@map("devoirs_faits")
}

/// Copie rendue par un élève (photos ou PDF), une par élève et par devoir ;
/// un nouvel envoi remplace le précédent.
model RenduDevoir {
  id           String    @id @default(uuid()) @db.Uuid
  ecoleId      String    @map("ecole_id") @db.Uuid
  devoirId     String    @map("devoir_id") @db.Uuid
  eleveId      String    @map("eleve_id") @db.Uuid
  commentaire  String?   @db.VarChar(500)
  rendLe       DateTime  @default(now()) @map("rend_le") @db.Timestamptz(3)
  /// Lecture et appréciation de l'enseignant
  vuLe         DateTime? @map("vu_le") @db.Timestamptz(3)
  appreciation String?   @db.VarChar(500)

  ecole    Ecole          @relation(fields: [ecoleId], references: [id], onDelete: Restrict)
  devoir   Devoir         @relation(fields: [devoirId], references: [id], onDelete: Cascade)
  eleve    Eleve          @relation(fields: [eleveId], references: [id], onDelete: Restrict)
  fichiers RenduFichier[]

  @@unique([devoirId, eleveId])
  @@index([ecoleId])
  @@map("rendus_devoirs")
}

/// Page d'une copie rendue (photo JPEG/PNG ou PDF, contenu contrôlé par signature).
model RenduFichier {
  id              String @id @default(uuid()) @db.Uuid
  ecoleId         String @map("ecole_id") @db.Uuid
  renduId         String @map("rendu_id") @db.Uuid
  ordre           Int    @db.SmallInt
  nomFichier      String @map("nom_fichier") @db.VarChar(255)
  cheminFichier   String @map("chemin_fichier") @db.VarChar(500)
  typeMime        String @map("type_mime") @db.VarChar(100)
  tailleOctets    Int    @map("taille_octets")
  empreinteSha256 String @map("empreinte_sha256") @db.Char(64)

  ecole Ecole       @relation(fields: [ecoleId], references: [id], onDelete: Restrict)
  rendu RenduDevoir @relation(fields: [renduId], references: [id], onDelete: Cascade)

  @@unique([renduId, ordre])
  @@index([ecoleId])
  @@map("rendus_fichiers")
}

// =============================================================================
// EduCourses : cours en ligne de la 6e à la Terminale, selon le programme national.
// Catalogue national (sans ecole_id, comme le référentiel) et profils d'apprenants
// rattachés à un compte (élève, ou enfants d'un parent).
// =============================================================================

/// Programme d'une discipline pour une classe (et une ou plusieurs séries au second cycle).
model EcProgramme {
  id          String             @id @default(uuid()) @db.Uuid
  /// « SIXIEME|MATH| », « TERMINALE|MATH|C », « SECONDE|SVT|A1+A2+B+C+D »
  cle         String             @unique @db.VarChar(120)
  niveau      Niveau
  series      String[]           @db.VarChar(5)
  matiereCode String             @map("matiere_code") @db.VarChar(40)
  nomMatiere  String             @map("nom_matiere") @db.VarChar(150)
  confiance   ConfianceProgramme
  sources     Json
  /// Validé par le ministère : jamais écrasé par le chargement des données
  estVerifie  Boolean            @default(false) @map("est_verifie")
  ordre       Int                @default(0) @db.SmallInt
  majLe       DateTime           @updatedAt @map("maj_le") @db.Timestamptz(3)

  chapitres EcChapitre[]

  @@index([niveau])
  @@map("ec_programmes")
}

model EcChapitre {
  id          String @id @default(uuid()) @db.Uuid
  programmeId String @map("programme_id") @db.Uuid
  ordre       Int    @db.SmallInt
  titre       String @db.VarChar(250)

  programme EcProgramme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  lecons    EcLecon[]

  @@unique([programmeId, ordre])
  @@map("ec_chapitres")
}

model EcLecon {
  id          String    @id @default(uuid()) @db.Uuid
  chapitreId  String    @map("chapitre_id") @db.Uuid
  ordre       Int       @db.SmallInt
  titre       String    @db.VarChar(250)
  objectifs   String[]  @db.VarChar(300)
  /// Contenu rédigé (vide tant que la leçon n'est pas écrite)
  duree       Int?      @db.SmallInt
  contenuHtml String?   @map("contenu_html")
  /// [{ titre, niveau, enonceHtml, corrigeHtml }]
  exercices   Json?
  /// [{ question, choix[], bonne, explication }] — la bonne réponse ne quitte jamais le serveur
  quiz        Json?
  /// Empreinte du fichier source, pour ne recharger que les leçons modifiées
  empreinte   String?   @db.Char(64)
  redigeeLe   DateTime? @map("redigee_le") @db.Timestamptz(3)

  chapitre     EcChapitre      @relation(fields: [chapitreId], references: [id], onDelete: Cascade)
  progressions EcProgression[]

  @@unique([chapitreId, ordre])
  @@map("ec_lecons")
}

/// Apprenant : l'élève lui-même (profil automatique) ou un enfant suivi par un parent
/// (même téléphone partagé : un profil par enfant, comme sur une application vidéo).
model EcProfil {
  id          String   @id @default(uuid()) @db.Uuid
  titulaireId String   @map("titulaire_id") @db.Uuid
  /// Élève EduRelevé correspondant (sa classe donne le niveau et la série)
  eleveId     String?  @map("eleve_id") @db.Uuid
  prenom      String   @db.VarChar(100)
  niveau      Niveau
  serie       String?  @db.VarChar(5)
  creeLe      DateTime @default(now()) @map("cree_le") @db.Timestamptz(3)

  titulaire    Utilisateur     @relation(fields: [titulaireId], references: [id], onDelete: Cascade)
  progressions EcProgression[]

  @@unique([titulaireId, eleveId])
  @@index([titulaireId])
  @@map("ec_profils")
}

model EcProgression {
  id            String    @id @default(uuid()) @db.Uuid
  profilId      String    @map("profil_id") @db.Uuid
  leconId       String    @map("lecon_id") @db.Uuid
  termineeLe    DateTime? @map("terminee_le") @db.Timestamptz(3)
  meilleurScore Int?      @map("meilleur_score") @db.SmallInt
  dernierScore  Int?      @map("dernier_score") @db.SmallInt
  tentatives    Int       @default(0) @db.SmallInt
  majLe         DateTime  @updatedAt @map("maj_le") @db.Timestamptz(3)

  profil EcProfil @relation(fields: [profilId], references: [id], onDelete: Cascade)
  lecon  EcLecon  @relation(fields: [leconId], references: [id], onDelete: Cascade)

  @@unique([profilId, leconId])
  @@map("ec_progressions")
}

/// Abonnement payant (Mobile Money), prévu mais inactif tant que EDUCOURSES_PAYANT=false.
model EcAbonnement {
  id          String           @id @default(uuid()) @db.Uuid
  titulaireId String           @map("titulaire_id") @db.Uuid
  statut      StatutAbonnement @default(EN_ATTENTE)
  debut       DateTime?        @db.Timestamptz(3)
  fin         DateTime?        @db.Timestamptz(3)
  montantFcfa Int              @map("montant_fcfa")
  fournisseur String           @db.VarChar(30)
  reference   String           @unique @db.VarChar(100)
  creeLe      DateTime         @default(now()) @map("cree_le") @db.Timestamptz(3)

  titulaire Utilisateur @relation(fields: [titulaireId], references: [id], onDelete: Restrict)

  @@index([titulaireId])
  @@map("ec_abonnements")
}
